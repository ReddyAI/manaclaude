{
  "expo": {
    "name": "Mana",
    "slug": "manaclaude",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mana",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000814",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reddyai.manaclaude"
    },
    "android": {
      "package": "com.reddyai.manaclaude",
      "adaptiveIcon": {
        "backgroundColor": "#000814",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000814",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mana reads a receipt photo you pick so it can be attached to a transaction.",
          "cameraPermission": "Mana uses the camera to photograph a receipt for a transaction."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["image/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
