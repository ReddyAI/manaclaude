{
  "name": "@manaclaude/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The app: Expo + React Native + TypeScript for Android, web and iOS.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "build:web": "expo export --platform web --output-dir dist",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest --ci",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
