# Copy to .dev.vars for `wrangler dev` (git-ignored). In production set each
# one with `npx wrangler secret put NAME`. Never commit real values.

# Bearer token the app sends to /v1 (any long random string).
APP_API_TOKEN=
# Password you type on the MCP sign-in page when connecting Claude or Perplexity.
MCP_OWNER_PASSWORD=
# Key that encrypts saved connector logins (any long random string; never change it once real logins are saved).
CREDENTIALS_SECRET=
# Open Exchange Rates app ID (free plan) for the hourly rate fetch.
OXR_APP_ID=
# Optional own AI keys. Workers AI needs no key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local dev only: lets POST /v1/dev/seed load the invented sample data.
ALLOW_SAMPLE_SEED=
# Connector keys (all optional; see docs/setup.md for where each comes from).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SOPHTRON_USER_ID=
SOPHTRON_ACCESS_KEY=
KITE_API_KEY=
KITE_API_SECRET=
# "true" lets the app link banks through Plaid (off by default; see docs/setup.md, step 7).
PLAID_LINK_ENABLED=
